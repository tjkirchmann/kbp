# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# OpenAI
OPENAI_API_KEY=sk-...

# College Football Data API
CFBD_API_KEY=...

# Discord bot (gateway listener + poster). Leave token empty to disable the bot.
# Create an app at https://discord.com/developers/applications, copy the Bot token here.
# For the chat/relay listener you MUST also enable "Message Content Intent" in the
# portal (Bot → Privileged Gateway Intents) or message.content arrives empty.
# See RAILWAY.md for the full setup walkthrough (token, intents, invite URL).
DISCORD_BOT_TOKEN=
# Dev: set to your test server's id for instant slash-command sync. Empty → global
# sync, which can take up to an hour to appear.
DISCORD_GUILD_ID=

# AWS S3 (file library). Local dev uses MinIO — those values are hardcoded in
# docker-compose.yml, so leave this block empty locally. In PRODUCTION set these
# in the Railway service env and leave S3_ENDPOINT_URL / S3_PUBLIC_ENDPOINT_URL
# UNSET so boto3 talks to real AWS. See RAILWAY.md for bucket/IAM/CORS setup.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET_NAME=

# CORS and infra URLs are hardcoded in docker-compose.yml for local dev.
# On Railway, set all variables (including DATABASE_URL, ALLOWED_ORIGINS)
# directly in the Railway service environment — see RAILWAY.md.
