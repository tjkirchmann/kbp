# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# OpenAI
OPENAI_API_KEY=sk-...

# College Football Data API
CFBD_API_KEY=...

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# OpenRouter (document analysis). Can also be set from the admin panel.
OPENROUTER_API_KEY=sk-or-...

# Object storage (S3 API). Local dev uses MinIO via docker-compose (vars set
# there). For prod S3, leave S3_ENDPOINT_URL unset and provide AWS creds + bucket.
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=documents

# CORS and infra URLs are hardcoded in docker-compose.yml for local dev.
# On Railway, set all variables (including DATABASE_URL, ALLOWED_ORIGINS)
# directly in the Railway service environment — see RAILWAY.md.
