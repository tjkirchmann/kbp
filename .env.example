# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# OpenAI
OPENAI_API_KEY=sk-...

# OpenRouter (structured-output runner via pydantic-ai)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_DEFAULT_MODEL=z-ai/glm-5.2

# College Football Data API
CFBD_API_KEY=...

# Discord bot (gateway listener + poster). Leave token empty to disable the bot.
# Create an app at https://discord.com/developers/applications, copy the Bot token here.
# For the chat/relay listener you MUST also enable "Message Content Intent" in the
# portal (Bot → Privileged Gateway Intents) or message.content arrives empty.
# See RAILWAY.md for the full setup walkthrough (token, intents, invite URL).
DISCORD_BOT_TOKEN=
# Dev: set to your test server's id for instant slash-command sync. Empty → global
# sync, which can take up to an hour to appear.
DISCORD_GUILD_ID=

# AWS S3 (file library). Local dev uses MinIO — those values are hardcoded in
# docker-compose.yml, so leave this block empty locally. In PRODUCTION set these
# in the Railway service env and leave S3_ENDPOINT_URL / S3_PUBLIC_ENDPOINT_URL
# UNSET so boto3 talks to real AWS. See RAILWAY.md for bucket/IAM/CORS setup.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET_NAME=

# Temporal
# Local self-host: the docker-compose `temporal` service sets the address; these
# defaults (in app/core/config.py) work as-is, so you can leave them unset locally.
#   TEMPORAL_ADDRESS=temporal:7233
#   TEMPORAL_NAMESPACE=default
#   TEMPORAL_TASK_QUEUE=kbp-default
#
# Migrating to Temporal Cloud is env-only (no code change): create an API key and
# point these at your Cloud namespace. app/core/temporal.py turns on TLS + API-key
# auth automatically when TEMPORAL_API_KEY is set.
#   TEMPORAL_ADDRESS=<region>.<cloud-provider>.api.temporal.io:7233
#   TEMPORAL_NAMESPACE=<your-namespace>.<account-id>
#   TEMPORAL_API_KEY=<your-temporal-cloud-api-key>

# Reconcile struct-output Temporal Schedules on worker boot. When enabled, the
# worker creates/updates Temporal Schedules for each structured-output definition
# (e.g. program_profile) and backfills missed runs via the catch-up window.
# OFF by default (dev-safe — avoids LLM/OpenRouter calls on every container start).
# Set to "1" or "true" in production only.
#   TEMPORAL_RECONCILE_STRUCT_OUTPUT=false

# MCP servers — read-only Postgres access
# The mcp_readonly user is auto-created by the mcp-db-setup one-shot service.
# Local dev default: postgresql+asyncpg://mcp_readonly:mcp_readonly@localhost:5432/app
MCP_DATABASE_URL=postgresql+asyncpg://mcp_readonly:mcp_readonly@localhost:5432/app
# Password must match what mcp-db-setup creates (change both if you change one).
MCP_READONLY_PASSWORD=mcp_readonly

# CORS and infra URLs are hardcoded in docker-compose.yml for local dev.
# On Railway, set all variables (including DATABASE_URL, ALLOWED_ORIGINS)
# directly in the Railway service environment — see RAILWAY.md.
